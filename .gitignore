# Rust build targets
/target/
*.pdb

# Binaries in project root
/AeroGraph.exe
*.exe
!assets/bin/wkhtmltoimage.exe

# Dynamic runtime render output & intermediate caches
/assets/images/*.png
!assets/images/.gitkeep
/assets/work/*
!assets/work/.gitkeep
/assets/briefing/*.html
/assets/data/DDS_Backup/
*.tmp
*.log
aerograph.log

# Local user configuration (dynamically created by AeroGraph at runtime)
kneeboards.json
aerograph.toml
/custom/*
!/custom/.gitkeep

# Installer build output
/installer/output/

# Next.js GUI dependencies & build artifacts
/ui/node_modules/
/ui/.next/
/ui/out/
*.tsbuildinfo
/ui/public/images/*.png
!/ui/public/images/.gitkeep
*.WebView2/
